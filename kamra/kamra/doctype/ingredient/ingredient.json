   "fieldname": "uom",
   "fieldtype": "Data",
   "label": "Unit",
   "length": 16,
   "default": "kg",
   "reqd": 1,
   "in_list_view": 1,
   "description": "The one unit stock, recipes, counts and wastage use. It cannot change once the ingredient has stock history or is on a recipe. Buying by the box or sack? Set a buying unit."
  },
  {
   "fieldname": "buy_uom",
   "fieldtype": "Data",
   "label": "Buying unit",
   "length": 16,
   "description": "Optional, e.g. box or sack."
  },
  {
   "fieldname": "buy_size",
   "fieldtype": "Float",
   "label": "Stock units per buying unit"
  },
  {
   "fieldname": "cost_per_unit",
   "fieldtype": "Currency",
   "label": "Cost / Unit",
   "in_list_view": 1,
   "description": "What one stock unit costs, used for wastage and dish costs. A priced delivery updates it. Indicative only - it does not tie to the books."
  },
  {
   "fieldname": "gst_rate",
   "fieldtype": "Percent",
   "label": "Input GST %",
   "default": "5",
   "description": "The tax paid on buying this. Claimable as input credit only where the output supply allows it."
  },
  {
   "fieldname": "is_active",
   "fieldtype": "Check",
   "label": "Active",
   "default": "1"
  },
  {
   "fieldname": "made_section",
   "fieldtype": "Section Break",
   "label": "Made here"
  },
  {
   "fieldname": "is_made",
   "fieldtype": "Check",
   "label": "Made here (semi-finished)",
   "default": "0",
   "description": "Made in your kitchen from other ingredients, in batches. Its cost is worked out from the recipe, and it cannot be received as a delivery."
  },
  {
   "fieldname": "batch_qty",
   "fieldtype": "Float",
   "label": "One batch makes",
   "depends_on": "eval:doc.is_made",
   "description": "In the stock unit."
  },
  {
   "fieldname": "recipe",
   "fieldtype": "Table",
   "label": "Made from",
   "options": "Menu Item Ingredient",
   "depends_on": "eval:doc.is_made",
   "description": "What one batch uses, from bought ingredients."
  }
