{
 "doctype": "DocType",
 "name": "WhatsApp Template",
 "module": "Kamra",
 "engine": "InnoDB",
 "naming_rule": "Expression",
 "autoname": "format:WATPL-{#####}",
 "editable_grid": 0,
 "field_order": [
  "property",
  "template_name",
  "column_break_a",
  "category",
  "language",
  "sb_content",
  "header_type",
  "header_text",
  "body",
  "footer",
  "buttons_json",
  "samples_json",
  "sb_meta",
  "meta_status",
  "meta_id",
  "rejection_reason"
 ],
 "fields": [
  {
   "fieldname": "property",
   "fieldtype": "Link",
   "label": "Property",
   "options": "Property",
   "reqd": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "template_name",
   "fieldtype": "Data",
   "label": "Template Name",
   "reqd": 1,
   "in_list_view": 1,
   "description": "Lowercase letters, numbers and underscores - Meta's rule"
  },
  {
   "fieldname": "column_break_a",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "category",
   "fieldtype": "Select",
   "label": "Category",
   "options": "Utility\nMarketing\nAuthentication",
   "default": "Utility",
   "in_list_view": 1
  },
  {
   "fieldname": "language",
   "fieldtype": "Data",
   "label": "Language",
   "default": "en"
  },
  {
   "fieldname": "sb_content",
   "fieldtype": "Section Break",
   "label": "Content"
  },
  {
   "fieldname": "header_type",
   "fieldtype": "Select",
   "label": "Header",
   "options": "None\nText",
   "default": "None"
  },
  {
   "fieldname": "header_text",
   "fieldtype": "Data",
   "label": "Header Text"
  },
  {
   "fieldname": "body",
   "fieldtype": "Small Text",
   "label": "Body",
   "reqd": 1,
   "description": "Up to 1024 chars; variables as {{1}}, {{2}}, ..."
  },
  {
   "fieldname": "footer",
   "fieldtype": "Data",
   "label": "Footer"
  },
  {
   "fieldname": "buttons_json",
   "fieldtype": "Long Text",
   "label": "Buttons (JSON)"
  },
  {
   "fieldname": "samples_json",
   "fieldtype": "Long Text",
   "label": "Variable Samples (JSON)"
  },
  {
   "fieldname": "sb_meta",
   "fieldtype": "Section Break",
   "label": "Meta"
  },
  {
   "fieldname": "meta_status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nPending\nApproved\nRejected\nPaused",
   "default": "Draft",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "meta_id",
   "fieldtype": "Data",
   "label": "Meta Template ID",
   "read_only": 1
  },
  {
   "fieldname": "rejection_reason",
   "fieldtype": "Small Text",
   "label": "Rejection Reason",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "email": 1,
   "print": 1,
   "report": 1,
   "share": 1,
   "export": 1
  },
  {
   "role": "Hotel Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "email": 1,
   "print": 1,
   "report": 1,
   "share": 1,
   "export": 1
  },
  {
   "role": "Front Desk",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "email": 1,
   "print": 1,
   "report": 1,
   "share": 1,
   "export": 1
  },
  {
   "role": "Kamra Agent",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "email": 1,
   "print": 1,
   "report": 1,
   "share": 1,
   "export": 1
  },
  {
   "role": "Finance",
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0,
   "email": 1,
   "print": 1,
   "report": 1,
   "share": 1,
   "export": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "links": [],
 "actions": [],
 "states": [],
 "allow_rename": 0
}
