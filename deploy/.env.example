# Kamra self-host — copy to /opt/kamra/kamra.env (install.sh writes this for you).
# Three WordPress-style values live in install.sh prompts; this file is compose-only.

DB_PASSWORD=CHANGE_ME_LONG_RANDOM
CUSTOM_IMAGE=ghcr.io/kamra-pms/kamra
CUSTOM_TAG=latest
PULL_POLICY=always
FRAPPE_SITE_NAME_HEADER=pms.yourhotel.com
HTTP_PUBLISH_PORT=8080

# Used only by install.sh / cloud-init (not by compose itself):
# SITE_NAME=pms.yourhotel.com
# ADMIN_EMAIL=you@yourhotel.com
# ADMIN_PASSWORD=  (min 10 chars — never commit)
# LETSENCRYPT_EMAIL=you@yourhotel.com
